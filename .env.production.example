NODE_ENV=production
PORT=4000
# Public HTTP port. Use 8081 if port 80 is already occupied by another service.
APP_PORT=80
DATABASE_URL=postgresql://resume_pilot:replace-with-a-long-password@db:5432/resume_pilot
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=7d
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
CORS_ORIGIN=http://your-server-ip
FRONTEND_URL=http://your-server-ip
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://your-server-ip/api/auth/github/callback
POSTGRES_USER=resume_pilot
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=resume_pilot

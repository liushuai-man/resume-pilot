    "@langchain/langgraph": "^0.0.21",
    "@langchain/openai": "^0.0.21",
    "@prisma/client": "^5.10.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "esbuild": "^0.28.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.18",
    "multer": "^2.2.0",

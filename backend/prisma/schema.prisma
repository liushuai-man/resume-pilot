generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  github_id     String            @unique
  github_login  String
  github_avatar String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  is_deleted    Boolean           @default(false)
  chat_sessions ChatSession[]
  interviews    InterviewResult[]
  resumes       Resume[]
  model_configs UserModelConfig[]
  ai_memories   AiMemory[]
  job_descriptions JobDescription[]
  job_profiles     JobProfile[]
  content_analyses ResumeContentAnalysis[]
  job_match_analyses JobMatchAnalysis[]

  @@map("users")
}

model Resume {
  id                String            @id @default(uuid())
  user_id           String
  template_id       String?
  title             String
  content           Json
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  is_deleted        Boolean           @default(false)
  chat_sessions     ChatSession[]
  interview_results InterviewResult[]
  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ai_memories       AiMemory[]
  content_analyses  ResumeContentAnalysis[]
  job_match_analyses JobMatchAnalysis[]

  @@index([user_id])
  @@map("resumes")
}

model Template {
  id            String   @id @default(uuid())
  name          String
  category      String
  thumbnail     String?
  preview_image String?
  schema        Json
  style_config  Json
  is_featured   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_deleted    Boolean  @default(false)
  data_hash     String?

  @@map("templates")
}

model ChatSession {
  id           String            @id @default(uuid())
  user_id      String
  resume_id    String?
  title        String
  session_type String
  summary      String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  is_deleted   Boolean           @default(false)
  messages     ChatMessage[]
  resume       Resume?           @relation(fields: [resume_id], references: [id])
  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  interviews   InterviewResult[]

  @@index([user_id])
  @@index([resume_id])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String      @id @default(uuid())
  session_id String
  role       String
  content    Json
  token      Int?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  is_deleted Boolean     @default(false)
  session    ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("chat_messages")
}

model InterviewResult {
  id         String       @id @default(uuid())
  user_id    String
  session_id String?
  resume_id  String?
  position   String
  score      Int
  report     Json
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  is_deleted Boolean      @default(false)
  resume     Resume?      @relation(fields: [resume_id], references: [id])
  session    ChatSession? @relation(fields: [session_id], references: [id])
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_id])
  @@index([resume_id])
  @@map("interview_results")
}

model UserModelConfig {
  id           String   @id @default(uuid())
  user_id      String
  provider     String
  model_name   String
  api_key      String
  base_url     String?
  display_name String
  purpose      String   @default("chat")
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  is_deleted   Boolean  @default(false)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, purpose])
  @@map("user_model_configs")
}

model ResumeContentAnalysis {
  id                String   @id @default(uuid())
  user_id           String
  resume_id         String
  resume_updated_at DateTime
  content_hash      String
  score             Int
  dimensions        Json
  issues            Json
  overall_confidence Float
  model_name        String
  prompt_version    String
  evaluator_version String
  created_at        DateTime @default(now())
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  resume            Resume   @relation(fields: [resume_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([resume_id, created_at])
  @@map("resume_content_analyses")
}

model JobDescription {
  id           String       @id @default(uuid())
  user_id      String
  title        String?
  company      String?
  raw_text     String
  source_url   String?
  is_deleted   Boolean      @default(false)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  profiles     JobProfile[]

  @@index([user_id, updated_at])
  @@map("job_descriptions")
}

model JobProfile {
  id                 String         @id @default(uuid())
  job_description_id String
  user_id            String
  version            Int
  status             String         @default("draft")
  job_title          String
  seniority          String?
  industry           String?
  responsibilities   Json           @default("[]")
  required_skills    Json           @default("[]")
  preferred_skills   Json           @default("[]")
  keywords           Json           @default("[]")
  confidence         Float?
  parser_version     String
  prompt_version     String
  model_name         String?
  confirmed_at       DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  job_description    JobDescription @relation(fields: [job_description_id], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  match_analyses     JobMatchAnalysis[]

  @@unique([job_description_id, version])
  @@index([user_id, updated_at])
  @@map("job_profiles")
}

model JobMatchAnalysis {
  id                 String     @id @default(uuid())
  user_id            String
  resume_id          String
  resume_updated_at  DateTime
  job_profile_id     String
  score              Int
  dimensions         Json
  requirements       Json
  overall_confidence Float
  model_name         String
  prompt_version     String
  evaluator_version  String
  created_at         DateTime   @default(now())
  user               User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  resume             Resume     @relation(fields: [resume_id], references: [id], onDelete: Cascade)
  job_profile        JobProfile @relation(fields: [job_profile_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([resume_id, job_profile_id, created_at])
  @@map("job_match_analyses")
}

model AiMemory {
  id                  String   @id
  user_id             String
  session_id          String
  resume_id           String?
  content             String
  content_hash        String
  metadata            Json     @default("{}")
  embedding           Unsupported("vector")?
  embedding_dimension Int?
  embedding_model     String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  resume              Resume?  @relation(fields: [resume_id], references: [id], onDelete: Cascade)

  @@unique([user_id, session_id, content_hash], map: "ai_memories_turn_key")
  @@index([user_id, embedding_model, embedding_dimension], map: "ai_memories_vector_idx")
  @@index([user_id, session_id], map: "ai_memories_session_idx")
  @@index([resume_id], map: "ai_memories_resume_idx")
  @@map("ai_memories")
}

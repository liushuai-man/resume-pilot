generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  github_id     String            @unique
  github_login  String
  github_avatar String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  is_deleted    Boolean           @default(false)
  chat_sessions ChatSession[]
  interviews    InterviewResult[]
  resumes       Resume[]

  @@map("users")
}

model Resume {
  id                String            @id @default(uuid())
  user_id           String
  template_id       String?
  title             String
  content           Json
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  is_deleted        Boolean           @default(false)
  chat_sessions     ChatSession[]
  interview_results InterviewResult[]
  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("resumes")
}

model Template {
  id            String   @id @default(uuid())
  name          String
  category      String
  thumbnail     String?
  preview_image String?
  schema        Json
  style_config  Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_deleted    Boolean  @default(false)
  data_hash     String?

  @@map("templates")
}

model ChatSession {
  id           String            @id @default(uuid())
  user_id      String
  resume_id    String?
  title        String
  session_type String
  summary      String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  is_deleted   Boolean           @default(false)
  messages     ChatMessage[]
  resume       Resume?           @relation(fields: [resume_id], references: [id])
  user         User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  interviews   InterviewResult[]

  @@index([user_id])
  @@index([resume_id])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String      @id @default(uuid())
  session_id String
  role       String
  content    Json
  token      Int?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  is_deleted Boolean     @default(false)
  session    ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("chat_messages")
}

model InterviewResult {
  id         String       @id @default(uuid())
  user_id    String
  session_id String?
  resume_id  String?
  position   String
  score      Int
  report     Json
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  is_deleted Boolean      @default(false)
  resume     Resume?      @relation(fields: [resume_id], references: [id])
  session    ChatSession? @relation(fields: [session_id], references: [id])
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_id])
  @@index([resume_id])
  @@map("interview_results")
}
